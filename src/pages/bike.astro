---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Bike Scan - Raghav Watts">
    <canvas id="bike"></canvas>

    <div class="tag">
        <h1>Meteor 350, scanned</h1>
        <p>Phone video → RealityScan mesh + Gaussian splat → three.js. Real-world scale. Click the front tyre to swap it.</p>
    </div>

    <p id="loading" class="loading">Loading <span id="what">splat</span> <span id="pct">0%</span></p>

    <div id="part" class="part" hidden>
        <button id="partClose" class="x" aria-label="Close">×</button>
        <h2>Front tyre</h2>
        <p>19" front · splat hidden in this region, part placed on the measured axle</p>
        <button class="opt" data-tyre="scan" aria-pressed="true"><b>As fitted</b><small>from the scan</small></button>
        <button class="opt" data-tyre="block" aria-pressed="false"><b>Block tread 100/90‑19</b><small>dual‑purpose · generated GLB</small></button>
    </div>

    <div class="bar">
        <button id="bSplat" aria-pressed="true">Splat</button>
        <button id="bMesh" aria-pressed="false">Mesh</button>
        <button id="bClay" aria-pressed="false">Clay</button>
        <button id="bSpin" aria-pressed="false">Turntable</button>
        <button data-view="tyre">Front tyre</button>
        <button data-view="lamp">Headlight</button>
        <button data-view="tank">Tank</button>
        <button data-view="home">Reset view</button>
    </div>
</Layout>

<script>
    import { mountBike, type TyreOption } from "../scripts/bike";
    const $ = (id: string) => document.getElementById(id)!;
    const canvas = $("bike") as HTMLCanvasElement;
    const pct = $("pct"), what = $("what"), loading = $("loading");
    const bike = mountBike(canvas, (label, p) => { what.textContent = label; pct.textContent = p + "%"; });
    bike.ready
        .then(() => (loading.hidden = true))
        .catch(() => (loading.textContent = "The scan didn't load. Refresh to try again."));

    const press = (el: HTMLElement, on: boolean) => el.setAttribute("aria-pressed", String(on));
    const bSplat = $("bSplat"), bMesh = $("bMesh"), bClay = $("bClay"), bSpin = $("bSpin");
    let splatOn = true, meshOn = false, clayOn = false;
    bSplat.addEventListener("click", () => { splatOn = !splatOn; bike.setSplat(splatOn); press(bSplat, splatOn); });
    bMesh.addEventListener("click", () => { meshOn = !meshOn; bike.setMesh(meshOn); press(bMesh, meshOn); });
    bClay.addEventListener("click", () => { clayOn = !clayOn; bike.setClay(clayOn); press(bClay, clayOn); });
    bSpin.addEventListener("click", () => press(bSpin, bike.toggleSpin()));
    document.querySelectorAll<HTMLButtonElement>("[data-view]").forEach((b) =>
        b.addEventListener("click", () => bike.go(b.dataset.view as "home" | "tyre" | "lamp" | "tank")),
    );

    // Part panel
    const panel = $("part");
    bike.onPick((part) => { panel.hidden = part !== "tyre"; });
    $("partClose").addEventListener("click", () => { panel.hidden = true; bike.deselect(); });
    const opts = document.querySelectorAll<HTMLButtonElement>("[data-tyre]");
    opts.forEach((b) =>
        b.addEventListener("click", async () => {
            opts.forEach((o) => press(o, o === b));
            await bike.fitTyre(b.dataset.tyre as TyreOption);
        }),
    );
</script>

<style is:global>
    html, body { height: 100%; overflow: hidden; }
</style>

<style>
    canvas { display: block; width: 100vw; height: 100dvh; touch-action: none; }
    .tag {
        position: fixed; top: 16px; left: 16px; max-width: min(340px, calc(100vw - 32px));
        background: color-mix(in srgb, var(--surface) 88%, transparent);
        border: 1px solid var(--line); border-radius: 6px; padding: 12px 14px; color: var(--text);
    }
    .tag h1 { margin: 0; font: 600 20px "Fraunces", serif; }
    .tag p { margin: 4px 0 0; font: 400 13px "Hanken Grotesk", sans-serif; color: var(--muted); }
    .loading { position: fixed; inset: 0; display: grid; place-items: center; margin: 0;
        font: 400 13px "JetBrains Mono", monospace; color: var(--muted); pointer-events: none; }
    .loading[hidden] { display: none; }
    .bar { position: fixed; left: 0; right: 0; bottom: 16px; display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; padding-inline: 16px; }
    .bar button { font: 500 13px "Hanken Grotesk", sans-serif; color: var(--text); background: var(--surface);
        border: 1px solid var(--line); border-radius: 999px; padding: 8px 14px; cursor: pointer; }
    .bar button[aria-pressed="true"] { border-color: var(--accent); color: var(--accent); }
    .bar button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

    .part {
        position: fixed; right: 16px; bottom: 72px; width: min(300px, calc(100vw - 32px));
        background: color-mix(in srgb, var(--surface) 92%, transparent);
        border: 1px solid var(--accent); border-radius: 8px; padding: 12px 14px; color: var(--text);
    }
    .part[hidden] { display: none; }
    .part h2 { margin: 0 0 2px; font: 600 16px "Fraunces", serif; }
    .part p { margin: 0 0 10px; font: 400 12px "Hanken Grotesk", sans-serif; color: var(--muted); }
    .part .opt { display: block; width: 100%; text-align: left; font: 500 13px "Hanken Grotesk", sans-serif; color: var(--text);
        background: transparent; border: 1px solid var(--line); border-radius: 6px; padding: 8px 10px; margin-top: 6px; cursor: pointer; }
    .part .opt[aria-pressed="true"] { border-color: var(--accent); }
    .part .opt small { display: block; font: 400 11px "JetBrains Mono", monospace; color: var(--muted); }
    .part .x { position: absolute; top: 6px; right: 10px; background: none; border: 0; color: var(--muted); font-size: 18px; cursor: pointer; }
</style>
