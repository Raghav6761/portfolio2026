---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Bike Scan - Raghav Watts">
    <canvas id="bike"></canvas>

    <div class="tag">
        <h1>Meteor 350, scanned</h1>
        <p>Phone video → RealityScan mesh + Gaussian splat → three.js. Real-world scale. Click either tyre to swap it.</p>
        <p class="note">Parts were labelled by SAM 3 on 120 of the photos and voted onto 980k Gaussians; wheels cut by fitted geometry. Tyres use the measured split. Nothing was labelled by hand.</p>
    </div>

    <details class="parts" id="parts">
        <summary>Parts <span id="partsN"></span></summary>
        <div class="modes">
            <button id="mPhoto" aria-pressed="true">Photo</button>
            <button id="mPart" aria-pressed="false">By part</button>
            <button id="mAll">Show all</button>
        </div>
        <div class="list" id="partList"></div>
        <p class="hint">tick = show · name = only that part · name again = all</p>
    </details>

    <p id="loading" class="loading">Loading <span id="what">splat</span> <span id="pct">0%</span></p>

    <div id="part" class="part" hidden>
        <button id="partClose" class="x" aria-label="Close">×</button>
        <h2 id="partTitle"></h2>
        <p id="partSub"></p>
        <div id="partOpts"></div>
        <div class="adj" id="partAdj">
            <label>along axle <input type="range" id="adjZ" min="-40" max="40" step="1" value="0" /><span id="adjZv">0 mm</span></label>
            <label>fore / aft <input type="range" id="adjX" min="-40" max="40" step="1" value="0" /><span id="adjXv">0 mm</span></label>
            <label>up / down <input type="range" id="adjY" min="-40" max="40" step="1" value="0" /><span id="adjYv">0 mm</span></label>
            <button id="adjReset">reset</button>
        </div>
    </div>

    <div class="bar">
        <button id="bSplat" aria-pressed="true">Splat</button>
        <button id="bMesh" aria-pressed="false">Mesh</button>
        <button id="bClay" aria-pressed="false">Clay</button>
        <button id="bSpin" aria-pressed="false">Turntable</button>
        <button data-view="tyre">Front tyre</button>
        <button data-view="rear">Rear tyre</button>
        <button data-view="lamp">Headlight</button>
        <button data-view="tank">Tank</button>
        <button data-view="home">Reset view</button>
    </div>
</Layout>

<script>
    import { mountBike, type WheelKey } from "../scripts/bike";
    const $ = (id: string) => document.getElementById(id)!;
    const canvas = $("bike") as HTMLCanvasElement;
    const pct = $("pct"), what = $("what"), loading = $("loading");
    const bike = mountBike(canvas, (label, p) => { what.textContent = label; pct.textContent = p + "%"; });
    bike.ready
        .then(() => { loading.hidden = true; buildPartsPanel(); })
        .catch(() => (loading.textContent = "The scan didn't load. Refresh to try again."));

    // ---- parts panel ----
    function buildPartsPanel() {
        const meta = bike.parts();
        const list = $("partList");
        $("partsN").textContent = `· ${meta.parts.length - 2} labelled`;
        const rows: Record<string, HTMLElement> = {};
        const sync = () => {
            const st = bike.partState();
            for (const p of meta.parts) {
                const row = rows[p]; const show = st.visible[p] && (st.solo === null || st.solo === p);
                row.classList.toggle("dim", !show); row.classList.toggle("solo", st.solo === p);
                (row.querySelector("input") as HTMLInputElement).checked = !!st.visible[p];
            }
            press($("mPhoto"), st.mode === "photo"); press($("mPart"), st.mode === "flat");
        };
        meta.parts.forEach((p, i) => {
            const row = document.createElement("label"); row.className = "row";
            const c = meta.colors[i];
            row.innerHTML = `<input type="checkbox"><span class="sw" style="background:rgb(${c.join(",")})"></span><span class="name">${p}</span><span class="n">${((meta.sizes[p] ?? 0) / 1000).toFixed(1)}k</span>`;
            row.querySelector("input")!.addEventListener("change", (e) => { bike.setPartVisible(p, (e.target as HTMLInputElement).checked); sync(); });
            row.querySelector(".name")!.addEventListener("click", (e) => { e.preventDefault(); bike.setSolo(bike.partState().solo === p ? null : p); sync(); });
            list.appendChild(row); rows[p] = row;
        });
        $("mPhoto").addEventListener("click", () => { bike.setMode("photo"); sync(); });
        $("mPart").addEventListener("click", async () => { sync(); loading.hidden = false; await bike.setMode("flat"); loading.hidden = true; sync(); });
        $("mAll").addEventListener("click", () => { bike.showAllParts(); sync(); });
        sync();
    }

    const press = (el: HTMLElement, on: boolean) => el.setAttribute("aria-pressed", String(on));
    const bSplat = $("bSplat"), bMesh = $("bMesh"), bClay = $("bClay"), bSpin = $("bSpin");
    let splatOn = true, meshOn = false, clayOn = false;
    bSplat.addEventListener("click", () => { splatOn = !splatOn; bike.setSplat(splatOn); press(bSplat, splatOn); });
    bMesh.addEventListener("click", () => { meshOn = !meshOn; bike.setMesh(meshOn); press(bMesh, meshOn); });
    bClay.addEventListener("click", () => { clayOn = !clayOn; bike.setClay(clayOn); press(bClay, clayOn); });
    bSpin.addEventListener("click", () => press(bSpin, bike.toggleSpin()));
    document.querySelectorAll<HTMLButtonElement>("[data-view]").forEach((b) =>
        b.addEventListener("click", () => bike.go(b.dataset.view as "home" | "tyre" | "rear" | "lamp" | "tank")),
    );

    // ---- part panel ----
    const panel = $("part"), adjBox = $("partAdj");
    let selected: WheelKey | null = null;

    const syncAdj = () => {
        if (!selected) return;
        const a = bike.adjustment(selected);
        for (const [ax, v] of [["X", a.x], ["Y", a.y], ["Z", a.z]] as const) {
            const mm = Math.round(v * 1000);
            ($("adj" + ax) as HTMLInputElement).value = String(mm);
            $("adj" + ax + "v").textContent = mm + " mm";
        }
        adjBox.style.display = bike.fittedOn(selected) === "scan" ? "none" : "grid";
    };
    const render = () => {
        bike.select(selected);
        if (!selected) { panel.hidden = true; return; }
        const W = bike.wheels[selected];
        $("partTitle").textContent = W.title;
        $("partSub").textContent = W.sub;
        const opts: [string, string, string][] = [["scan", "As fitted", "from the scan"], ...Object.entries(W.parts).map(([k, p]) => [k, p.label, p.small] as [string, string, string])];
        $("partOpts").innerHTML = opts.map(([k, l, sm]) =>
            `<button class="opt" data-pk="${k}" aria-pressed="${bike.fittedOn(selected!) === k}"><b>${l}</b><small>${sm}</small></button>`).join("");
        $("partOpts").querySelectorAll<HTMLButtonElement>("button").forEach((b) =>
            b.addEventListener("click", async () => { await bike.fit(selected!, b.dataset.pk!); render(); }));
        syncAdj();
        panel.hidden = false;
    };
    bike.onPick((wk) => { selected = wk; render(); });
    $("partClose").addEventListener("click", () => { selected = null; render(); });
    for (const ax of ["X", "Y", "Z"] as const) {
        ($("adj" + ax) as HTMLInputElement).addEventListener("input", (e) => {
            if (!selected) return;
            const mm = +(e.target as HTMLInputElement).value;
            bike.nudge(selected, { [ax.toLowerCase()]: mm });
            $("adj" + ax + "v").textContent = mm + " mm";
        });
    }
    $("adjReset").addEventListener("click", () => { if (!selected) return; bike.nudge(selected, { x: 0, y: 0, z: 0 }); syncAdj(); });
</script>

<style is:global>
    html, body { height: 100%; overflow: hidden; }
</style>

<style>
    canvas { display: block; width: 100vw; height: 100dvh; touch-action: none; }
    .tag {
        position: fixed; top: 16px; left: 16px; max-width: min(340px, calc(100vw - 32px));
        background: color-mix(in srgb, var(--surface) 88%, transparent);
        border: 1px solid var(--line); border-radius: 6px; padding: 12px 14px; color: var(--text);
    }
    .tag h1 { margin: 0; font: 600 20px "Fraunces", serif; }
    .tag p { margin: 4px 0 0; font: 400 13px "Hanken Grotesk", sans-serif; color: var(--muted); }
    .tag .note { margin-top: 8px; font-size: 12px; }
    .parts {
        position: fixed; left: 16px; top: 150px; width: min(280px, calc(100vw - 32px)); max-height: calc(100dvh - 240px); overflow: auto;
        background: color-mix(in srgb, var(--surface) 90%, transparent); border: 1px solid var(--line); border-radius: 8px; padding: 10px 12px; color: var(--text);
    }
    .parts summary { cursor: pointer; font: 600 14px "Fraunces", serif; }
    .parts .modes { display: flex; gap: 6px; margin: 10px 0; }
    .parts .modes button { font: 500 12px "Hanken Grotesk", sans-serif; color: var(--text); background: var(--surface); border: 1px solid var(--line); border-radius: 999px; padding: 5px 11px; cursor: pointer; }
    .parts .modes button[aria-pressed="true"] { border-color: var(--accent); color: var(--accent); }
    .parts .list { display: grid; gap: 1px; font: 400 11.5px "JetBrains Mono", monospace; }
    .parts .row { display: grid; grid-template-columns: 16px 12px 1fr auto; align-items: center; gap: 8px; padding: 3px 6px; border-radius: 5px; cursor: pointer; }
    .parts .row:hover { background: color-mix(in srgb, var(--text) 7%, transparent); }
    .parts .row.dim { opacity: .45; } .parts .row.solo { outline: 1px solid var(--accent); }
    .parts .row input { accent-color: var(--accent); margin: 0; } .parts .sw { width: 12px; height: 12px; border-radius: 3px; border: 1px solid #0006; }
    .parts .n { color: var(--muted); }
    .parts .hint { margin: 8px 0 0; font: 400 11px "JetBrains Mono", monospace; color: var(--muted); }
    @media (max-width: 640px) { .parts { top: auto; bottom: 72px; max-height: 40dvh; } .tag .note { display: none; } }
    .loading { position: fixed; inset: 0; display: grid; place-items: center; margin: 0;
        font: 400 13px "JetBrains Mono", monospace; color: var(--muted); pointer-events: none; }
    .loading[hidden] { display: none; }
    .bar { position: fixed; left: 0; right: 0; bottom: 16px; display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; padding-inline: 16px; }
    .bar button { font: 500 13px "Hanken Grotesk", sans-serif; color: var(--text); background: var(--surface);
        border: 1px solid var(--line); border-radius: 999px; padding: 8px 14px; cursor: pointer; }
    .bar button[aria-pressed="true"] { border-color: var(--accent); color: var(--accent); }
    .bar button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

    .part {
        position: fixed; right: 16px; bottom: 72px; width: min(300px, calc(100vw - 32px));
        background: color-mix(in srgb, var(--surface) 92%, transparent);
        border: 1px solid var(--accent); border-radius: 8px; padding: 12px 14px; color: var(--text);
    }
    .part[hidden] { display: none; }
    .part h2 { margin: 0 0 2px; font: 600 16px "Fraunces", serif; }
    .part p { margin: 0 0 10px; font: 400 12px "Hanken Grotesk", sans-serif; color: var(--muted); }
    .part .opt { display: block; width: 100%; text-align: left; font: 500 13px "Hanken Grotesk", sans-serif; color: var(--text);
        background: transparent; border: 1px solid var(--line); border-radius: 6px; padding: 8px 10px; margin-top: 6px; cursor: pointer; }
    .part .opt[aria-pressed="true"] { border-color: var(--accent); }
    .part .opt small { display: block; font: 400 11px "JetBrains Mono", monospace; color: var(--muted); }
    .part .adj { margin-top: 10px; border-top: 1px solid var(--line); padding-top: 8px; display: grid; gap: 4px;
        font: 400 11px "JetBrains Mono", monospace; color: var(--muted); }
    .part .adj label { display: grid; grid-template-columns: 70px 1fr 48px; align-items: center; gap: 8px; }
    .part .adj input { width: 100%; accent-color: var(--accent); }
    .part .adj button { justify-self: end; font: 500 11px "Hanken Grotesk", sans-serif; color: var(--muted); background: none;
        border: 1px solid var(--line); border-radius: 999px; padding: 3px 10px; cursor: pointer; }
    .part .x { position: absolute; top: 6px; right: 10px; background: none; border: 0; color: var(--muted); font-size: 18px; cursor: pointer; }
</style>
