---
import { getCollection } from "astro:content";
import FoundationCard from "./FoundationCard.astro";

const foundations = (await getCollection("foundations")).sort(
    (a, b) => a.data.order - b.data.order
);
---

<section id="foundations">
    <div class="wrap">
        <div class="sec-head">
            <span class="num">02</span>
            <h2>Foundations</h2>
        </div>

        <p class="sec-intro">
            Products I've built and owned - Each one a head start, not a blank page.
            Tell me your problem; odds are one of these is already most of the way there.
        </p>

        <div class="founds">
            {foundations.map((f) => (
                <FoundationCard
                    title={f.data.title}
                    status={f.data.status}
                    summary={f.data.summary}
                    couldBecome={f.data.couldBecome}
                />
            ))}
        </div>
    </div>
</section>

<style>
    section{
        padding: 110px 0;
        border-top: 1px solid var(--line);
    }

    .sec-head{
        display: flex;
        align-items: baseline;
        gap: 20px;
        margin-bottom: 22px;
    }
    .sec-head .num{
        font-family: var(--mono);
        font-size: 0.8rem;
        color: var(--accent);
    }
    .sec-head h2{
        font-family: var(--serif);
        font-weight: 400;
        font-size: clamp(1.8rem, 3.4vw, 2.7rem);
        letter-spacing: -0.01em;
    }

    .sec-intro{
        color: var(--muted);
        max-width: 58ch;
        margin-bottom: 46px;
        font-size: 1.02rem;
        line-height: 1.7;
    }

    .founds{
        display: flex;
        flex-direction: column;
        gap: 1px;
        background: var(--line);
        border: 1px solid var(--line);
    }
</style>