---
import { getCollection } from "astro:content";
import ProjectCard from "./ProjectCard.astro";

const projects = (await getCollection("projects")).sort(
    (a, b) => a.data.order - b.data.order,
);
---

<section id="work">
    <div class="wrap">
        <div class="sec-head">
            <span class="num">03</span>
            <h2>Built across domains</h2>
        </div>

        <p class="sec-intro">
            And proof I can land in an unfamiliar field and ship something that
            holds. A few I've built:
        </p>

        <div class="work-list">
            {
                projects.map((p) => (
                    <ProjectCard
                        title={p.data.title}
                        domain={p.data.domain}
                        description={p.data.description}
                        stack={p.data.stack}
                    />
                ))
            }
        </div>
    </div>
</section>

<style>
    section {
        padding: 110px 0;
        border-top: 1px solid var(--line);
    }

    .sec-head {
        display: flex;
        align-items: baseline;
        gap: 20px;
        margin-bottom: 22px;
    }
    .sec-head .num {
        font-family: var(--mono);
        font-size: 0.8rem;
        color: var(--accent);
    }
    .sec-head h2 {
        font-family: var(--serif);
        font-weight: 400;
        font-size: clamp(1.8rem, 3.4vw, 2.7rem);
        letter-spacing: -0.01em;
    }

    .sec-intro {
        color: var(--muted);
        max-width: 58ch;
        margin-bottom: 46px;
        font-size: 1.02rem;
        line-height: 1.7;
    }

    .work-list {
        display: flex;
        flex-direction: column;
        border-top: 1px solid var(--line);
    }
</style>
